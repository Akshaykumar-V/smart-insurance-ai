# Copy to backend/.env. Use a disposable Supabase project and fictional PDFs.
SUPABASE_URL=https://your-project.supabase.co
# Public publishable key or legacy anon key for the existing v0.1 workflow.
# The approved condition-results writer requires a backend-only service key.
SUPABASE_PUBLISHABLE_KEY=replace-with-your-project-public-key
SUPABASE_SERVICE_ROLE_KEY=
MAX_UPLOAD_BYTES=20971520
MAX_PDF_PAGES=200
MAX_EXTRACTED_CHARACTERS=2000000
PDF_TIMEOUT_SECONDS=20
CORS_ORIGINS=["http://localhost:3000"]

# Opt-in Milestone 3A; apply migration 202610260004 first.
AI_EXTRACTION_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_MAX_INPUT_CHARACTERS=120000
AI_TIMEOUT_SECONDS=90

# Claim-condition discovery remains disabled until the new API contract and
# read-only-to-users condition tables are approved and deployed.
CONDITION_EXTRACTION_ENABLED=false
CONDITION_MAX_PROVIDER_REQUESTS=2
